# Copy this file to .env and paste your key. Never commit or share .env.
ANTHROPIC_API_KEY=
# Optional overrides
# PREREAD_MODEL=claude-sonnet-5-5
# LIVE_MODEL=claude-haiku-5-5      (fast panel decisions during the pitch)
# SCORE_MODEL=claude-sonnet-5-5    (end Q&A and scoring)
# Optional realistic voices (one of these; without it the browser's own voices are used)
# OPENAI_API_KEY=            (OpenAI text-to-speech, about US$0.015 per minute of speech; handles Australian accents well)
# ELEVENLABS_API_KEY=
# TTS_PROVIDER=off           (force browser voices)
